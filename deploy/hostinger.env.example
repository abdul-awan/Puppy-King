# Settings of the live site on Hostinger shared hosting.
# On the server: copy this file to .env, fill in the values marked "FILL IN", then run
#   php artisan key:generate
# Never upload your local .env: it has your local passwords and key.

APP_NAME="Billing"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# FILL IN: your domain, with https
APP_URL=https://yourdomain.com
APP_TIMEZONE=Asia/Karachi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=notice
LOG_DEPRECATIONS_CHANNEL=null

# FILL IN from hPanel -> Databases -> Management (the names start with your u123456789_ prefix).
# Use mariadb when phpMyAdmin shows "Server type: MariaDB", otherwise mysql.
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_billing
DB_USERNAME=u123456789_billing
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared hosting runs no queue worker: e-mails (team invitations) are sent straight away.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# FILL IN from hPanel -> Emails: create a mailbox such as billing@yourdomain.com.
# The "from" address must be that same mailbox.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=billing@yourdomain.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="billing@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
